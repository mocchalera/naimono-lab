{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naimono-lab",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "naimono-lab.mocchalera.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
